# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# JWT_SECRET: Secret key for signing and verifying JWT authentication tokens
JWT_SECRET="zomato-super-secure-production-jwt-secret-key-2026"

# RAZORPAY_KEY_ID: Razorpay test mode Key ID
RAZORPAY_KEY_ID="rzp_test_zomato_demo_2026"

# RAZORPAY_KEY_SECRET: Razorpay test mode Key Secret
RAZORPAY_KEY_SECRET="secret_zomato_test_key_84920"

# MONGO_URI: Optional MongoDB connection URI if using external database cluster
MONGO_URI="mongodb://localhost:27017/zomato_db"
